# Copiar a .env y ajustar. El .env no se sube al repositorio.

# banco_id de ESTE banco (debe coincidir con config_banco en la base)
BANCO_ID=BCO1

# Clave privada Ed25519 de este banco (generar con: python -m scripts.generar_claves)
PRIVATE_KEY_PATH=keys/privada.pem

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=banco_familiar

# Firma entre bancos (doc 02)
VENTANA_FIRMA_SEG=300
TIMEOUT_OTROS_BANCOS_SEG=5

# Login (JWT). Generar el secreto con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_MINUTOS=30
MAX_INTENTOS_LOGIN=5
BLOQUEO_LOGIN_MIN=15

# CORS para el frontend (separar con comas; * = cualquiera, solo desarrollo)
CORS_ORIGINS=*

# Sesión: cierre por inactividad (segundos) y tope absoluto desde el login (JWT_MINUTOS)
INACTIVIDAD_SEG=300
